# Passwort für den Moderator-Bereich (/admin). Pflicht im Betrieb.
MODERATOR_PASSWORD=
# API-Key für das KI-Clustering (console.anthropic.com). Ohne Key: nur manuelles Clustern.
ANTHROPIC_API_KEY=
# Gehostete Datenbank (turso.tech). Ohne diese beiden Werte liegt alles in einer lokalen Datei,
# die bei einem Gratis-Hoster beim Einschlafen verloren geht.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Öffentliche Adresse der App, wird in den QR-Code geschrieben. Beispiel: https://klartext.example.de
PUBLIC_URL=
# Optional
# PORT=3000
# DB_PATH=./data/klartext.db   (nur ohne TURSO_DATABASE_URL)
# RETENTION_DAYS=30
# CLUSTER_MODEL=claude-opus-5-5
